TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_OWNER_ID=123456789

# Only needed for Google authorization; use an absolute path outside the repository.
# On Windows use forward slashes; quote paths containing spaces.
GOOGLE_CLIENT_SECRETS="C:/private/desktop-client.json"
# Fixed callback port (1-65535); change this if 8080 is busy.
YM_AUTH_PORT=8080

# Optional: separate Gemini Free tier project with Cloud Billing disabled
GEMINI_API_KEY=
